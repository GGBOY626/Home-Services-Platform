# Copy to .env.prod and fill in values. Do not commit .env.prod.

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=home_services
MYSQL_USER=app
MYSQL_PASSWORD=change-me-app-password

# JWT (min 256 bits for HS256; use a long random string in production)
JWT_SECRET=change-me-jwt-secret-minimum-32-chars-for-hs256

# Public base URL (how users reach the app in browser; no trailing slash)
APP_PUBLIC_BASE_URL=http://localhost:8088

# Ports (backend is internal; nginx is external)
BACKEND_PORT=8080
NGINX_PORT=8088

# Storage (path inside backend container)
STORAGE_LOCAL_ROOT=/data/uploads

# CORS (comma-separated; include every origin users load the frontend from)
# Add both IP and domain if the site is accessible via both
CORS_ALLOWED_ORIGINS=http://124.223.111.66:8088,http://zhengwei.tech:8088

# Stripe payment configuration
# Get your keys from https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_*, pk_test_*) for development/staging
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
# Webhook secret from Stripe Dashboard > Developers > Webhooks
# Leave empty if webhook endpoint is not configured yet
STRIPE_WEBHOOK_SECRET=

# Mapbox token (baked into all 4 frontend bundles at Docker build time)
# Get from https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=pk.replace_me
